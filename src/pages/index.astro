---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import mascotImage from "../assets/milosaurio-mascot-full-transparent.webp";

// "default" | "halloween" — cambia el tema completo de la página.
const THEME = "halloween";
const isHalloween = THEME === "halloween";

const WHATSAPP_NUMBER = "522491754458";
const WHATSAPP_MESSAGE = isHalloween
	? "Hola Milosaurio, quiero aprovechar la promoción de Halloween"
	: "Hola Milosaurio, quiero rentar un inflable";
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
const coverageImage = isHalloween
	? "/images/milosaurio-zona-cobertura-halloween.webp"
	: "/images/milosaurio-zona-cobertura.webp";

const products = [
	{
		name: "Cubo Interactivo",
		price: "$500",
		size: "Tamaño chico · 4×3 m · altura 2 m",
		description:
			"Ideal para espacios reducidos.",
		image: "/images/cubo-interactivo.webp",
		tone: "a",
	},
	{
		name: "Castillo de Olas",
		price: "$700",
		size: "Tamaño mediano · 5×4 m · altura 2.7 m",
		description: "Con resbaladilla — el clásico infaltable en toda fiesta.",
		image: "/images/castillo-olas.webp",
		tone: "b",
	},
	{
		name: "Túneles",
		price: "$700",
		size: "Tamaño mediano · 5×3 m · altura 2.4 m",
		description: "Circuito para gatear y trepar — aventura sin parar.",
		image: "/images/tuneles.webp",
		tone: "c",
	},
];

const steps = [
	{
		number: 1,
		tone: "a",
		title: "Elige tu inflable",
		text: "Escríbenos por WhatsApp con la fecha de tu evento.",
	},
	{
		number: 2,
		tone: "b",
		title: "Confirma tu reserva",
		text: "Apartamos el inflable con un anticipo.",
	},
	{
		number: 3,
		tone: "c",
		title: "Entrega e instalación",
		text: "Llegamos, instalamos y probamos todo antes de la fiesta.",
	},
	{
		number: 4,
		tone: "a",
		title: "¡A divertirse!",
		text: "Recogemos el equipo al finalizar el evento.",
	},
];

const galleryPlaceholders = [
	{ label: "foto evento 1", from: "#5FBFA0", to: "#8FD3BC" },
	{ label: "foto evento 2", from: "#F4B183", to: "#F7C8A4" },
	{ label: "foto evento 3", from: "#B9A6DB", to: "#CDBEE6" },
	{ label: "foto evento 4", from: "#5FBFA0", to: "#8FD3BC" },
];
---

<Layout theme={THEME}>
	{
		isHalloween && (
			<a
				class="promo-bar"
				href={WHATSAPP_URL}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>
					<span aria-hidden="true">🎃</span>
					<strong>¡Aprovecha la promoción de Halloween!</strong>
				</span>
				<span class="promo-bar-cta">Reserva por WhatsApp →</span>
				<span class="promo-bar-ghost" aria-hidden="true">👻</span>
			</a>
		)
	}
	<a
		class="wa-float"
		href={WHATSAPP_URL}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Contactar por WhatsApp"
	>
		<svg width="30" height="30" viewBox="0 0 24 24" fill="none">
			<path
				d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.1-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Z"
				fill="#fff"></path>
			<path
				d="M8.6 7.6c-.24-.53-.4-.5-.65-.5-.2 0-.44 0-.67.24-.24.24-.9.88-.9 2.14 0 1.26.92 2.48 1.05 2.65.13.17 1.8 2.9 4.45 3.94 2.2.86 2.65.68 3.13.64.48-.05 1.55-.63 1.77-1.24.22-.6.22-1.13.15-1.24-.06-.1-.24-.17-.5-.3-.26-.13-1.55-.77-1.79-.85-.24-.1-.42-.14-.6.13-.17.26-.68.85-.83 1.03-.15.17-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.3-.78-.68-1.3-1.53-1.46-1.8-.15-.26-.02-.4.12-.53.12-.12.26-.3.4-.46.13-.16.17-.26.26-.44.09-.17.04-.33-.02-.46-.06-.13-.6-1.48-.84-2.02Z"
				fill="currentColor"></path>
		</svg>
	</a>

	<!-- HERO -->
	<section class="hero">
		{
			isHalloween && (
				<div class="hero-deco" aria-hidden="true">
					<svg width="0" height="0" focusable="false">
						<symbol id="bat" viewBox="0 0 60 30">
							<path d="M30 7 L33 3 L34 11 Q42 3 58 8 Q52 12 51 20 Q46 15 42 19 Q38 15 34 20 L30 27 L26 20 Q22 15 18 19 Q14 15 9 20 Q8 12 2 8 Q18 3 26 11 L27 3 Z" />
						</symbol>
					</svg>
					<svg class="cobweb" viewBox="0 0 150 150" fill="none">
						<path d="M0 0L150 0M0 0L138.6 57.4M0 0L106.1 106.1M0 0L57.4 138.6M0 0L0 150M35 0Q29.5 5.9 32.3 13.4Q25 16.7 24.7 24.7Q16.7 25 13.4 32.3Q5.9 29.5 0 35M65 0Q54.8 10.9 60.1 24.9Q46.5 31.1 46 46Q31.1 46.5 24.9 60.1Q10.9 54.8 0 65M95 0Q80.1 15.9 87.8 36.4Q67.9 45.4 67.2 67.2Q45.4 67.9 36.4 87.8Q15.9 80.1 0 95M125 0Q105.4 21 115.5 47.8Q89.4 59.7 88.4 88.4Q59.7 89.4 47.8 115.5Q21 105.4 0 125" />
					</svg>
					<svg class="bat bat-1" viewBox="0 0 60 30"><use href="#bat" /></svg>
					<svg class="bat bat-2" viewBox="0 0 60 30"><use href="#bat" /></svg>
					<svg class="bat bat-3" viewBox="0 0 60 30"><use href="#bat" /></svg>
				</div>
			)
		}
		<div class="wordmark">milosaurio</div>
		<div class="hero-row">
			<div class="hero-text">
				<h1>Diversión inflable<br />para toda la fiesta</h1>
				<p>
					Rentamos inflables para eventos infantiles: un cubo interactivo y
					dos castillos medianos. Reserva por WhatsApp en minutos.
				</p>
				<a class="cta" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
					Reservar por WhatsApp
				</a>
			</div>
			<div class="hero-image">
				{isHalloween && <div class="moon" aria-hidden="true" />}
				<Image
					src={mascotImage}
					alt="Mascota Milosaurio, niño disfrazado de dinosaurio monstruo de Halloween, saludando con su cubeta de calabaza"
					width={480}
					height={480}
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<!-- PROMO -->
	{
		isHalloween && (
			<section class="promo">
				<div class="promo-card">
					<span class="promo-emoji promo-emoji-left" aria-hidden="true">
						🎃
					</span>
					<div class="promo-copy">
						<span class="promo-tag">Edición Halloween</span>
						<h2>¡Aprovecha la promoción!</h2>
						<p>
							Reserva tu inflable para Halloween y haz que tu fiesta sea
							monstruosamente divertida.
						</p>
						<a
							class="cta"
							href={WHATSAPP_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							Quiero la promoción
						</a>
					</div>
					<span class="promo-emoji promo-emoji-right" aria-hidden="true">
						👻
					</span>
				</div>
			</section>
		)
	}

	<!-- PRODUCTS -->
	<section class="products">
		<h2>Nuestros inflables</h2>
		<p class="section-sub">Elige el que mejor se adapte a tu evento.</p>
		<div class="products-grid">
			{
				products.map((product) => (
					<div class="card" style={`background:var(--card-${product.tone}-bg);`}>
						<div class="card-photo-placeholder">
							<img
								src={product.image}
								alt={product.name}
								class="card-photo"
							/>
						</div>
						<div class="card-header">
							<h3>{product.name}</h3>
							<span class="card-price" style={`color:var(--card-${product.tone}-price);`}>
								{product.price}
							</span>
						</div>
						<p class="card-size">{product.size}</p>
						<p class="card-description">{product.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="how-it-works">
		<h2>¿Cómo funciona la renta?</h2>
		<div class="steps-grid">
			{
				steps.map((step) => (
					<div>
						<div class="step-circle" style={`background:var(--step-${step.tone});`}>
							{step.number}
						</div>
						<h4>{step.title}</h4>
						<p>{step.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- COVERAGE -->
	<section class="coverage">
		<div class="coverage-text">
			<h2>Zona de cobertura</h2>
			<p>
				Damos servicio en la ciudad y alrededores. Escríbenos tu ubicación
				por WhatsApp y te confirmamos disponibilidad.
			</p>
		</div>
		<div class="map-placeholder">
			<img
				src={coverageImage}
				alt="Mapa de zona de cobertura de Milosaurio"
				class="map-image"
			/>
		</div>
	</section>

	<!-- GALLERY -->
	<!-- <section class="gallery">
		<h2>Fiestas que hemos animado</h2>
		<div class="gallery-grid">
			{
				galleryPlaceholders.map((item) => (
					<div
						class="gallery-placeholder"
						style={`background: repeating-linear-gradient(45deg, ${item.from} 0 10px, ${item.to} 10px 20px);`}
					>
						<span class="placeholder-label small">{item.label}</span>
					</div>
				))
			}
		</div>
	</section> -->

	<!-- FOOTER -->
	<footer class="footer">
		<span class="footer-wordmark">milosaurio</span>
		<span class="footer-contact">WhatsApp: 249 175 4458</span>
	</footer>
</Layout>

<style>
	h1,
	h2,
	h3,
	h4,
	.wordmark,
	.cta,
	.step-circle,
	.footer-wordmark {
		font-family: "Baloo 2", sans-serif;
	}

	section,
	.footer {
		padding: 64px 72px;
	}

	/* Floating WhatsApp button */
	.wa-float {
		position: fixed;
		bottom: 32px;
		right: 32px;
		z-index: 30;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--brand);
		color: var(--brand);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10px 24px var(--brand-glow);
		text-decoration: none;
		transition: transform 0.15s ease;
	}
	.wa-float:hover {
		transform: scale(1.06);
	}

	/* HERO */
	.hero {
		padding: 56px 72px 100px;
		padding-bottom: 0px;
		background: var(--hero-bg);
	}
	.hero-dots {
		display: flex;
		gap: 16px;
		margin-bottom: 36px;
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}
	.wordmark {
		font-weight: 800;
		font-size: 34px;
		color: var(--text);
		margin-bottom: 18px;
	}
	.hero-row {
		display: flex;
		align-items: center;
		gap: 56px;
		flex-wrap: wrap;
	}
	.hero-text {
		max-width: 560px;
		flex: 1 1 400px;
	}
	.hero-text h1 {
		font-weight: 700;
		font-size: 56px;
		line-height: 1.08;
		color: var(--text);
		margin: 0 0 22px;
	}
	.hero-text p {
		font-size: 19px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0 0 32px;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--brand);
		color: var(--on-brand);
		font-weight: 800;
		font-size: 17px;
		padding: 16px 28px;
		border-radius: 16px;
		text-decoration: none;
		transition: filter 0.15s ease;
	}
	.cta:hover {
		filter: brightness(1.06);
	}
	.hero-image {
		flex: 1 1 380px;
		min-width: 380px;
		height: 520px;
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}
	.hero-image img {
		width: 100%;
		max-width: 480px;
		height: auto;
		object-fit: contain;
		display: block;
	}

	/* PRODUCTS */
	.products {
		background: var(--bg);
	}
	.products h2 {
		font-weight: 700;
		font-size: 32px;
		color: var(--text);
		margin: 0 0 8px;
	}
	.section-sub {
		font-size: 16px;
		color: var(--text-subtle);
		margin: 0 0 36px;
	}
	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 28px;
	}
	.card {
		border-radius: 20px;
		padding: 24px;
		box-shadow: var(--card-shadow);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--card-shadow-hover);
	}
	.card-photo-placeholder {
		height: 160px;
		border-radius: 14px;
		margin-bottom: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.card-photo {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.placeholder-label {
		font-family: monospace;
		font-size: 11px;
		background: #fff;
		padding: 4px 8px;
		border-radius: 6px;
	}
	.placeholder-label.small {
		font-size: 10px;
		padding: 3px 7px;
	}
	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 6px;
	}
	.card-header h3 {
		font-size: 21px;
		margin: 0;
		color: var(--text);
	}
	.card-price {
		font-weight: 700;
		font-size: 22px;
	}
	.card-size {
		font-size: 14px;
		color: var(--text-subtle);
		margin: 0 0 4px;
	}
	.card-description {
		font-size: 14px;
		color: var(--text-muted);
		line-height: 1.5;
		margin: 0;
	}

	/* HOW IT WORKS */
	.how-it-works {
		background: var(--bg-alt);
	}
	.how-it-works h2 {
		font-weight: 700;
		font-size: 32px;
		color: var(--text);
		margin: 0 0 36px;
	}
	.steps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 24px;
	}
	.step-circle {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		color: var(--on-brand);
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 14px;
	}
	.steps-grid h4 {
		font-size: 17px;
		margin: 0 0 6px;
		color: var(--text);
	}
	.steps-grid p {
		font-size: 14px;
		color: var(--text-muted);
		line-height: 1.5;
		margin: 0;
	}

	/* COVERAGE */
	.coverage {
		background: var(--bg);
		padding: 56px 72px;
		display: flex;
		align-items: center;
		gap: 48px;
		flex-wrap: wrap;
	}
	.coverage-text {
		flex: 1 1 320px;
	}
	.coverage-text h2 {
		font-weight: 700;
		font-size: 28px;
		color: var(--text);
		margin: 0 0 12px;
	}
	.coverage-text p {
		font-size: 16px;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}
	.map-placeholder {
		flex: 1 1 260px;
		min-width: 260px;
		height: 310px;
		border-radius: 18px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.map-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* GALLERY */
	.gallery {
		background: #f5f1fb;
		padding: 56px 72px 72px;
	}
	.gallery h2 {
		font-weight: 700;
		font-size: 28px;
		color: var(--text);
		margin: 0 0 28px;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 18px;
	}
	.gallery-placeholder {
		height: 130px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* FOOTER */
	.footer {
		padding: 32px 72px;
		background: var(--bg-footer);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: auto;
	}
	.footer-wordmark {
		font-weight: 700;
		color: #fff;
		font-size: 18px;
	}
	.footer-contact {
		font-size: 14px;
		color: var(--footer-text);
	}

	/* HALLOWEEN */
	.promo-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 4px 12px;
		padding: 10px 20px;
		background: linear-gradient(90deg, #ff7a18, #ff9a3c 50%, #ff7a18);
		color: #1a1024;
		font-size: 15px;
		text-align: center;
		text-decoration: none;
	}
	.promo-bar strong {
		margin-left: 6px;
		font-family: "Baloo 2", sans-serif;
		font-size: 17px;
		font-weight: 800;
	}
	.promo-bar-cta {
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.promo-bar:focus-visible {
		outline: 3px solid #1a1024;
		outline-offset: -3px;
	}

	:global([data-theme="halloween"]) .hero {
		position: relative;
	}
	:global([data-theme="halloween"]) .wordmark,
	:global([data-theme="halloween"]) .hero-row {
		position: relative;
		z-index: 1;
	}
	:global([data-theme="halloween"]) .hero-image img {
		position: relative;
		z-index: 1;
		filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.45));
	}
	:global([data-theme="halloween"]) .hero-text h1,
	:global([data-theme="halloween"]) .wordmark,
	:global([data-theme="halloween"]) .footer-wordmark,
	:global([data-theme="halloween"]) .promo h2 {
		font-family: "Creepster", "Baloo 2", sans-serif;
		font-weight: 400;
		letter-spacing: 0.03em;
	}
	:global([data-theme="halloween"]) .hero-text h1 {
		text-shadow: 0 0 28px rgba(255, 122, 24, 0.45);
	}
	:global([data-theme="halloween"]) .cta {
		box-shadow: 0 0 24px var(--brand-glow);
	}
	:global([data-theme="halloween"]) .map-placeholder {
		box-shadow: var(--card-shadow);
	}
	:global([data-theme="halloween"]) .footer {
		border-top: 3px solid var(--brand);
	}

	.hero-deco {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.cobweb {
		position: absolute;
		top: 0;
		left: 0;
		width: 150px;
		height: 150px;
		stroke: rgba(246, 236, 220, 0.35);
		stroke-width: 1;
	}
	.bat {
		position: absolute;
		fill: #4a2b6b;
		animation: bat-float 6s ease-in-out infinite;
	}
	.bat-1 {
		width: 64px;
		top: 14%;
		left: 46%;
	}
	.bat-2 {
		width: 40px;
		top: 34%;
		left: 60%;
		animation-duration: 7s;
		animation-delay: -2s;
	}
	.bat-3 {
		width: 52px;
		top: 8%;
		right: 6%;
		animation-delay: -4s;
	}
	@keyframes bat-float {
		0%,
		100% {
			transform: translate(0, 0) rotate(-5deg);
		}
		50% {
			transform: translate(18px, -14px) rotate(5deg);
		}
	}

	.moon {
		position: absolute;
		top: 24px;
		left: 50%;
		width: 300px;
		aspect-ratio: 1;
		transform: translateX(-50%);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #ffe3ad 0%, #ffb457 55%, #ff8a2a 100%);
		box-shadow: 0 0 90px 20px rgba(255, 138, 42, 0.45);
	}

	.promo {
		background: var(--bg);
		padding: 40px 72px 8px;
	}
	.promo-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 32px;
		padding: 36px 40px;
		border: 2px dashed #ff9a3c;
		border-radius: 24px;
