---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import mascotImage from "../assets/milosaurio-mascot-full-transparent.webp";

const WHATSAPP_NUMBER = "542491635872";
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
const WHATSAPP_FLOAT_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20Milosaurio%2C%20quiero%20rentar%20un%20inflable`;

const products = [
	{
		name: "Cubo Interactivo",
		price: "$600",
		size: "Tamaño chico",
		description:
			"Juegos de luces y sonido interactivos, ideal para espacios reducidos.",
		placeholder: "foto: cubo",
		cardBg: "#F4FBF7",
		accent: "#5FBFA0",
		accentLight: "#7FD0B7",
		priceColor: "#2C7C63",
	},
	{
		name: "Castillo de Olas",
		price: "$800",
		size: "Tamaño mediano",
		description: "Con resbaladilla — el clásico infaltable en toda fiesta.",
		placeholder: "foto: castillo de olas",
		cardBg: "#FFF6EC",
		accent: "#E29456",
		accentLight: "#F7C8A4",
		priceColor: "#A85A26",
	},
	{
		name: "Túneles",
		price: "$800",
		size: "Tamaño mediano",
		description: "Circuito para gatear y trepar — aventura sin parar.",
		placeholder: "foto: túneles",
		cardBg: "#F5F1FB",
		accent: "#8A6FC2",
		accentLight: "#CDBEE6",
		priceColor: "#6E58AA",
	},
];

const steps = [
	{
		number: 1,
		color: "#5FBFA0",
		title: "Elige tu inflable",
		text: "Escríbenos por WhatsApp con la fecha de tu evento.",
	},
	{
		number: 2,
		color: "#F4B183",
		title: "Confirma tu reserva",
		text: "Apartamos el inflable con un anticipo.",
	},
	{
		number: 3,
		color: "#B9A6DB",
		title: "Entrega e instalación",
		text: "Llegamos, instalamos y probamos todo antes de la fiesta.",
	},
	{
		number: 4,
		color: "#5FBFA0",
		title: "¡A divertirse!",
		text: "Recogemos el equipo al finalizar el evento.",
	},
];

const galleryPlaceholders = [
	{ label: "foto evento 1", from: "#5FBFA0", to: "#8FD3BC" },
	{ label: "foto evento 2", from: "#F4B183", to: "#F7C8A4" },
	{ label: "foto evento 3", from: "#B9A6DB", to: "#CDBEE6" },
	{ label: "foto evento 4", from: "#5FBFA0", to: "#8FD3BC" },
];
---

<Layout>
	<a
		class="wa-float"
		href={WHATSAPP_FLOAT_URL}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Contactar por WhatsApp"
	>
		<svg width="30" height="30" viewBox="0 0 24 24" fill="none">
			<path
				d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.1-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Z"
				fill="#fff"></path>
			<path
				d="M8.6 7.6c-.24-.53-.4-.5-.65-.5-.2 0-.44 0-.67.24-.24.24-.9.88-.9 2.14 0 1.26.92 2.48 1.05 2.65.13.17 1.8 2.9 4.45 3.94 2.2.86 2.65.68 3.13.64.48-.05 1.55-.63 1.77-1.24.22-.6.22-1.13.15-1.24-.06-.1-.24-.17-.5-.3-.26-.13-1.55-.77-1.79-.85-.24-.1-.42-.14-.6.13-.17.26-.68.85-.83 1.03-.15.17-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.3-.78-.68-1.3-1.53-1.46-1.8-.15-.26-.02-.4.12-.53.12-.12.26-.3.4-.46.13-.16.17-.26.26-.44.09-.17.04-.33-.02-.46-.06-.13-.6-1.48-.84-2.02Z"
				fill="#5FBFA0"></path>
		</svg>
	</a>

	<!-- HERO -->
	<section class="hero">
		<div class="hero-dots">
			<span class="dot" style="background:#5FBFA0;"></span>
			<span class="dot" style="background:#F4B183;"></span>
			<span class="dot" style="background:#B9A6DB;"></span>
		</div>
		<div class="wordmark">milosaurio</div>
		<div class="hero-row">
			<div class="hero-text">
				<h1>Diversión inflable<br />para toda la fiesta</h1>
				<p>
					Rentamos inflables para eventos infantiles: un cubo interactivo y
					dos castillos medianos. Reserva por WhatsApp en minutos.
				</p>
				<a class="cta" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
					Reservar por WhatsApp →
				</a>
			</div>
			<div class="hero-image">
				<Image
					src={mascotImage}
					alt="Mascota Milosaurio, niño disfrazado de dinosaurio saludando"
					width={480}
					height={480}
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<!-- PRODUCTS -->
	<section class="products">
		<h2>Nuestros inflables</h2>
		<p class="section-sub">Elige el que mejor se adapte a tu evento.</p>
		<div class="products-grid">
			{
				products.map((product) => (
					<div class="card" style={`background:${product.cardBg};`}>
						<div
							class="card-photo-placeholder"
							style={`background: repeating-linear-gradient(45deg, ${product.accent} 0 12px, ${product.accentLight} 12px 24px);`}
						>
							<span class="placeholder-label">{product.placeholder}</span>
						</div>
						<div class="card-header">
							<h3>{product.name}</h3>
							<span class="card-price" style={`color:${product.priceColor};`}>
								{product.price}
							</span>
						</div>
						<p class="card-size">{product.size}</p>
						<p class="card-description">{product.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="how-it-works">
		<h2>¿Cómo funciona la renta?</h2>
		<div class="steps-grid">
			{
				steps.map((step) => (
					<div>
						<div class="step-circle" style={`background:${step.color};`}>
							{step.number}
						</div>
						<h4>{step.title}</h4>
						<p>{step.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- COVERAGE -->
	<section class="coverage">
		<div class="coverage-text">
			<h2>Zona de cobertura</h2>
			<p>
				Damos servicio en la ciudad y alrededores. Escríbenos tu ubicación
				por WhatsApp y te confirmamos disponibilidad y costo de traslado.
			</p>
		</div>
		<div class="map-placeholder">
			<span class="placeholder-label">mapa de cobertura</span>
		</div>
	</section>

	<!-- GALLERY -->
	<section class="gallery">
		<h2>Fiestas que hemos animado</h2>
		<div class="gallery-grid">
			{
				galleryPlaceholders.map((item) => (
					<div
						class="gallery-placeholder"
						style={`background: repeating-linear-gradient(45deg, ${item.from} 0 10px, ${item.to} 10px 20px);`}
					>
						<span class="placeholder-label small">{item.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<!-- FOOTER -->
	<footer class="footer">
		<span class="footer-wordmark">milosaurio</span>
		<span class="footer-contact">WhatsApp: 2491 635872</span>
	</footer>
</Layout>

<style>
	h1,
	h2,
	h3,
	h4,
	.wordmark,
	.cta,
	.step-circle,
	.footer-wordmark {
		font-family: "Baloo 2", sans-serif;
	}

	section,
	.footer {
		padding: 64px 72px;
	}

	/* Floating WhatsApp button */
	.wa-float {
		position: fixed;
		bottom: 32px;
		right: 32px;
		z-index: 30;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: #5fbfa0;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10px 24px rgba(95, 191, 160, 0.5);
		text-decoration: none;
		transition: transform 0.15s ease;
	}
	.wa-float:hover {
		transform: scale(1.06);
	}

	/* HERO */
	.hero {
		padding: 56px 72px 100px;
		background: radial-gradient(circle at 85% 10%, #e9f6ef 0%, #fffbf3 55%);
	}
	.hero-dots {
		display: flex;
		gap: 16px;
		margin-bottom: 36px;
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}
	.wordmark {
		font-weight: 800;
		font-size: 34px;
		color: #3a332c;
		margin-bottom: 18px;
	}
	.hero-row {
		display: flex;
		align-items: center;
		gap: 56px;
		flex-wrap: wrap;
	}
	.hero-text {
		max-width: 560px;
		flex: 1 1 400px;
	}
	.hero-text h1 {
		font-weight: 700;
		font-size: 56px;
		line-height: 1.08;
		color: #3a332c;
		margin: 0 0 22px;
	}
	.hero-text p {
		font-size: 19px;
		line-height: 1.6;
		color: #6b6259;
		margin: 0 0 32px;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: #5fbfa0;
		color: #3a332c;
		font-weight: 800;
		font-size: 17px;
		padding: 16px 28px;
		border-radius: 16px;
		text-decoration: none;
		transition: filter 0.15s ease;
	}
	.cta:hover {
		filter: brightness(1.06);
	}
	.hero-image {
		flex: 1 1 380px;
		min-width: 380px;
		height: 520px;
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}
	.hero-image img {
		width: 100%;
		max-width: 480px;
		height: auto;
		object-fit: contain;
		display: block;
	}

	/* PRODUCTS */
	.products {
		background: #fffbf3;
	}
	.products h2 {
		font-weight: 700;
		font-size: 32px;
		color: #3a332c;
		margin: 0 0 8px;
	}
	.section-sub {
		font-size: 16px;
		color: #726960;
		margin: 0 0 36px;
	}
	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 28px;
	}
	.card {
		border-radius: 20px;
		padding: 24px;
		box-shadow: 0 8px 24px rgba(60, 40, 20, 0.06);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.card:hover {
		transform: translateY(-4px);
	}
	.card-photo-placeholder {
		height: 160px;
		border-radius: 14px;
		margin-bottom: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.placeholder-label {
		font-family: monospace;
		font-size: 11px;
		background: #fff;
		padding: 4px 8px;
		border-radius: 6px;
	}
	.placeholder-label.small {
		font-size: 10px;
		padding: 3px 7px;
	}
	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 6px;
	}
	.card-header h3 {
		font-size: 21px;
		margin: 0;
		color: #3a332c;
	}
	.card-price {
		font-weight: 700;
		font-size: 22px;
	}
	.card-size {
		font-size: 14px;
		color: #726960;
		margin: 0 0 4px;
	}
	.card-description {
		font-size: 14px;
		color: #6b6259;
		line-height: 1.5;
		margin: 0;
	}

	/* HOW IT WORKS */
	.how-it-works {
		background: #f4fbf7;
	}
	.how-it-works h2 {
		font-weight: 700;
		font-size: 32px;
		color: #3a332c;
		margin: 0 0 36px;
	}
	.steps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 24px;
	}
	.step-circle {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		color: #3a332c;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 14px;
	}
	.steps-grid h4 {
		font-size: 17px;
		margin: 0 0 6px;
		color: #3a332c;
	}
	.steps-grid p {
		font-size: 14px;
		color: #6b6259;
		line-height: 1.5;
		margin: 0;
	}

	/* COVERAGE */
	.coverage {
		background: #fffbf3;
		padding: 56px 72px;
		display: flex;
		align-items: center;
		gap: 48px;
		flex-wrap: wrap;
	}
	.coverage-text {
		flex: 1 1 320px;
	}
	.coverage-text h2 {
		font-weight: 700;
		font-size: 28px;
		color: #3a332c;
		margin: 0 0 12px;
	}
	.coverage-text p {
		font-size: 16px;
		color: #6b6259;
		line-height: 1.6;
		margin: 0;
	}
	.map-placeholder {
		flex: 1 1 260px;
		min-width: 260px;
		height: 160px;
		border-radius: 18px;
		background: repeating-linear-gradient(
			45deg,
			#b9a6db 0 12px,
			#cdbee6 12px 24px
		);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* GALLERY */
	.gallery {
		background: #f5f1fb;
		padding: 56px 72px 72px;
	}
	.gallery h2 {
		font-weight: 700;
		font-size: 28px;
		color: #3a332c;
		margin: 0 0 28px;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 18px;
	}
	.gallery-placeholder {
		height: 130px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* FOOTER */
	.footer {
		padding: 32px 72px;
		background: #3a332c;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}
	.footer-wordmark {
		font-weight: 700;
		color: #fff;
		font-size: 18px;
	}
	.footer-contact {
		font-size: 14px;
		color: #c9c1b6;
	}

	/* RESPONSIVE */
	@media (max-width: 768px) {
		section,
		.footer,
		.coverage,
		.gallery {
			padding: 40px 32px;
		}
		.hero {
			padding: 40px 32px 64px;
		}
		.hero-text h1 {
			font-size: 42px;
		}
		.hero-image {
			min-width: 0;
			height: auto;
		}
	}

	@media (max-width: 480px) {
		section,
		.footer,
		.coverage,
		.gallery {
			padding: 28px 20px;
		}
		.hero {
			padding: 28px 20px 48px;
		}
		.hero-text h1 {
			font-size: 34px;
		}
		.hero-text p {
			font-size: 17px;
		}
		.wordmark {
			font-size: 28px;
		}
		.wa-float {
			width: 56px;
			height: 56px;
			bottom: 20px;
			right: 20px;
		}
	}
</style>
